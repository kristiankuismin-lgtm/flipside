# Copy to .env and fill in. .env is gitignored.

# Required. The knowledge graph everything is built on.
#   https://console.cala.ai -> API keys
CALA_API_KEY=clsk_...

# Optional but worth setting. Without it, GitHub's unauthenticated search
# allows about ten queries a minute, so the "ships code publicly" component
# of the founder signal is almost always unchecked. A read-only personal
# access token with NO scopes raises the limit from 60/hour to 5000.
#   https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. 1 = never make a live call; serve everything from cache.
# Used for demos: the whole product runs from local data in about 2 seconds.
CALA_CACHE_ONLY=
